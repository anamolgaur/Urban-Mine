{
  "name": "urban-mine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Urban Mine: worker-first e-waste app (hackathon prototype). ALL DATA IS SAMPLE.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "seed": "node server/src/seed.ts",
    "check:strings": "node scripts/check-strings.mjs",
    "test": "node --test \"server/test/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "pdfkit": "^0.21.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^7.0.2"
  }
}
