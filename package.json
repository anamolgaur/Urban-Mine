{
  "name": "urban-mine",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Urban Mine: worker-first e-waste app (hackathon prototype). ALL DATA IS SAMPLE.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "node --env-file-if-exists=server/.env --watch-path=server/src --watch server/src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "seed": "node --env-file-if-exists=server/.env server/src/reset.ts",
    "check:strings": "node scripts/check-strings.mjs",
    "pretest": "node server/src/template.ts",
    "test": "node --test --test-force-exit \"server/test/*.test.ts\"",
    "start": "node --env-file-if-exists=server/.env server/src/index.ts",
    "db:check": "node --env-file-if-exists=server/.env server/src/check.ts",
    "auditor": "node --env-file-if-exists=server/.env server/src/auditor.ts",
    "storage:setup": "node --env-file-if-exists=server/.env server/src/storage.ts setup",
    "storage:check": "node --env-file-if-exists=server/.env server/src/storage.ts check",
    "postinstall": "node scripts/render-build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
