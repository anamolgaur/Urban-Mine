# Server settings. Copy to server/.env (never commit it) or set these in your API host's dashboard.

# Postgres connection string from Supabase: Project > Connect > "Transaction pooler" (port 6543).
# Leave unset in local dev: the server then uses a local PGlite database in .data/
DATABASE_URL=

# Optional: path to Supabase's CA certificate file, so the database's TLS certificate is verified.
DATABASE_CA=

# The address of the deployed web app, e.g. https://urban-mine.vercel.app (comma-separated for several). Unset allows any origin: dev only.
CORS_ORIGIN=

# Phone sign-in (Supabase Auth). Project Settings > API: the Project URL and the anon / publishable key (public by design).
# When both are set, the demo X-User-Id header is switched off.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Photo storage. With the service key set, photos go to a PRIVATE Supabase Storage bucket; without it they are kept on local disk (dev only).
# SERVER ONLY: this key bypasses every database rule. Never put it in the web app, Vercel or git.
# Supabase: Project Settings > API > service_role (or "secret") key.
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_BUCKET=photos
# Optional, local-disk store only: a fixed secret for photo links (otherwise random per start).
PHOTO_URL_SECRET=

# Photo condition check (fair-price vision). With a key, a worker who agrees can have photos of a device graded A-D by a Claude vision model,
# which adjusts the price range. Photos are sent to Anthropic's API ONLY after the worker agrees in the app. Without a key the check is simply off.
# SERVER ONLY. Create it at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: the model (default claude-sonnet-5-5; claude-haiku-5-5 costs less) and the checks allowed per person per day (default 20).
VISION_MODEL=
VISION_DAILY_LIMIT=

# Demo only: 1 allows the sample accounts (X-User-Id header) even when Supabase sign-in is configured. Leave unset in production.
DEMO_LOGIN=

# Set to 1 ONCE on an empty database to load the SAMPLE data.
SEED_DEMO=

# Hosts like Render set PORT themselves.
PORT=3000
