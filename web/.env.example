# Copy to .env.production (or set in Vercel > Project > Settings > Environment Variables).
# The public address of the API server. Leave unset in local dev: Vite proxies /api to localhost:3000.
VITE_API_URL=https://your-api-host.example.com

# Phone sign-in (Supabase Auth). Both are public values. Without them the app runs in demo mode with sample accounts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
